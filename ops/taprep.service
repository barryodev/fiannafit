# systemd unit for the TapRep app. provision.sh installs it to
# /etc/systemd/system/taprep.service; edit it here, never on the VM.
[Unit]
Description=TapRep (uvicorn)
After=network.target

[Service]
User=taprep
Group=taprep
WorkingDirectory=/opt/taprep
# Secrets (SESSION_SECRET_KEY, ...). Created by hand, never committed.
# No leading "-", so the service refuses to start if the file is missing.
EnvironmentFile=/etc/taprep/env
# Run the venv's uvicorn directly, not `uv run`, so starting the service
# never changes the environment. deploy.sh runs `uv sync --frozen` first.
# Bound to localhost only: Caddy is the public entry point (DAI-7).
ExecStart=/opt/taprep/.venv/bin/uvicorn taprep.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
