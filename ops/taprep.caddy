# Caddy site for TapRep. provision.sh installs it to
# /etc/caddy/sites/taprep.caddy, where the host's main Caddyfile
# (ops/host/Caddyfile) imports it; edit it here, never on the VM.
#
# Caddy gets and renews the Let's Encrypt certificate for this name and
# redirects http:// to https:// on its own.
taprep.barryodev.io {
	reverse_proxy 127.0.0.1:8000
}

# The app's old name. Redirects for one month after the rename, then this
# block and its DNS record are removed (DAI-30).
fiannafit.barryodev.io {
	redir https://taprep.barryodev.io{uri} permanent
}
